      "animations": [
        {
          "var.mca_ls": "limb_swing/if(is_child, 2, 1)/if(limb_speed>0.75, 1.4 +(0.2*random(id)), 1.1 +(0.2*random(id)))",
          "var.mca_r": "pi*random(id)*4",
          "var.mca_b": "age/(11 -random(id)*2)*if(is_child, 1.5, 1)",
          "var.mca_pose": "if(is_riding||is_in_water&&!is_on_ground, 0, clamp(1-limb_speed*4, 0, 1))*clamp(random(id)+0.3, 0.3, 1)",
          "var.mca_nov2": "if(random(id)<0.7, clamp(-78 +cos(-pi/4 +var.mca_r +var.mca_b/20)*80, 0, 1)*clamp(1-limb_speed*2, 0, 1), 0)",
          "var.mca_swim": "limb_swing/2 +age/4",
          "mca_right_arm.rx": "lerp(mca_work, if(!is_riding&&!is_on_ground&&is_in_water, torad(-50) -cos(var.mca_swim)/4*clamp(1-limb_speed*8, 0, 1) +(cos(var.mca_swim +sin(var.mca_swim)) +torad(30))*clamp(limb_speed*8, 0, 1), if(is_riding, torad(-45), -sin(var.mca_ls)*limb_speed) +torad(head_yaw)/8) +torad(5)*var.mca_pose +( -sin(-pi/3 +var.mca_r+var.mca_b +sin(var.mca_r+var.mca_b) )/6 )*var.mca_nov2 +(sin(limb_swing/2) -pi/4)/2*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0), mca_work_right_arm_rx)",
          "mca_left_arm.rx": "lerp(mca_work, if(!is_riding&&!is_on_ground&&is_in_water, torad(-50) -cos(var.mca_swim)/4*clamp(1-limb_speed*8, 0, 1) +(cos(var.mca_swim +sin(var.mca_swim)) +torad(30))*clamp(limb_speed*8, 0, 1), if(is_riding, torad(-45), sin(var.mca_ls)*limb_speed) -torad(head_yaw)/8) +torad(5)*var.mca_pose +( -sin(-pi/3 +var.mca_r+var.mca_b +sin(var.mca_r+var.mca_b) )/6 )*var.mca_nov2 +(sin(limb_swing/2) -pi/4)/2*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0), mca_work_left_arm_rx)",
          "mca_right_arm.ry": "lerp(mca_work, if(!is_riding&&!is_on_ground&&is_in_water, torad(30) -sin(var.mca_swim +cos(var.mca_swim)/4)*clamp(1-limb_speed*8, 0, 1) +(torad(5) +cos(pi/8 +var.mca_swim +sin(var.mca_swim)/2)/2 +clamp(-sin(var.mca_swim), -pi/2, 0))*clamp(limb_speed*8, 0, 1), if(is_riding, -torad(20), 0) -torad(15)*clamp(limb_speed*4, 0, 1) +cos(var.mca_r +var.mca_b)/30) -torad(5)*var.mca_pose, mca_work_right_arm_ry)",
          "mca_left_arm.ry": "lerp(mca_work, if(!is_riding&&!is_on_ground&&is_in_water, torad(-30) +sin(var.mca_swim +cos(var.mca_swim)/4)*clamp(1-limb_speed*8, 0, 1) +(torad(-5) -cos(pi/8 +var.mca_swim +sin(var.mca_swim)/2)/2 +clamp(sin(var.mca_swim), 0, pi/2))*clamp(limb_speed*8, 0, 1), if(is_riding, torad(20), 0) +torad(15)*clamp(limb_speed*4, 0, 1) -cos(var.mca_r +var.mca_b)/30) +torad(5)*var.mca_pose, mca_work_left_arm_ry)",
          "mca_right_arm.rz": "lerp(mca_work, if(!is_riding&&!is_on_ground&&is_in_water, -cos(var.mca_swim)/2 +(torad(20) +cos(var.mca_swim)/2)*clamp(limb_speed*8, 0, 1), 0) -torad(head_pitch)/14 +torad(8 +0.5*var.mca_pose), mca_work_right_arm_rz)",
          "mca_left_arm.rz": "lerp(mca_work, if(!is_riding&&!is_on_ground&&is_in_water, cos(var.mca_swim)/2 +(torad(-20) -cos(var.mca_swim)/2)*clamp(limb_speed*8, 0, 1), 0) +torad(head_pitch)/14 +torad(-8 +0.5*var.mca_pose), mca_work_left_arm_rz)",
          "head.sx": "if(is_child, 1.2, 1)",
          "head.sy": "if(is_child, 1.2, 1)",
          "head.sz": "if(is_child, 1.2, 1)",
          "mca_r_eye_closed.visible": "mca_sleeping > 0.5",
          "mca_l_eye_closed.visible": "mca_sleeping > 0.5",
          "r_eye_white.visible": "mca_sleeping < 0.5",
          "l_eye_white.visible": "mca_sleeping < 0.5",
          "r_pupil.visible": "mca_sleeping < 0.5",
          "l_pupil.visible": "mca_sleeping < 0.5",
          "mca_mouth_inside.visible": "mca_talk > 0.05",
          "mca_mouth_inside.sx": "(1 +0.5*mca_talk_wide*mca_talk)/max(mouth.sx, 0.1)",
          "mca_tongue.visible": "mca_talk > 0.4",
          "mca_tongue.tx": "sin(age*0.37 +random(id)*6)*0.25*mca_talk",
          "mca_mouth_inside.sy": "(1 +mca_talk)/(1 +0.5*mca_talk_wide*mca_talk)/max(mouth.sy, 0.1)",
          "mca_tongue.sx": "1/max(mouth.sx, 0.1)",
          "mca_tongue.sy": "0.75/max(mouth.sy, 0.1)",
          "mca_mouth_inside.rz": "-mouth.rz",
          "mca_tongue.rz": "-mouth.rz",
          "body.rx": "lerp(mca_work, body.rx, mca_work_body_rx)",
          "head.rx": "head.rx +mca_work*mca_work_head_rx",
          "right_leg.rx": "right_leg.rx +mca_work*mca_work_right_leg_rx",
          "left_leg.rx": "left_leg.rx +mca_work*mca_work_left_leg_rx",
          "body.ry": "lerp(mca_work, body.ry, mca_work_body_ry)",
          "head.ry": "head.ry +mca_work*mca_work_head_ry",
          "right_leg.ry": "right_leg.ry +mca_work*mca_work_right_leg_ry",
          "left_leg.ry": "left_leg.ry +mca_work*mca_work_left_leg_ry",
          "body.rz": "lerp(mca_work, body.rz, mca_work_body_rz)",
          "head.rz": "head.rz +mca_work*mca_work_head_rz",
          "right_leg.rz": "right_leg.rz +mca_work*mca_work_right_leg_rz",
          "left_leg.rz": "left_leg.rz +mca_work*mca_work_left_leg_rz",
          "body.tx": "body.tx -mca_work*mca_work_root_tx",
          "body.ty": "body.ty -mca_work*mca_work_root_ty",
          "body.tz": "body.tz +mca_work*mca_work_root_tz",
          "head.tx": "head.tx -mca_work*mca_work_root_tx",
          "head.ty": "head.ty -mca_work*mca_work_root_ty",
          "head.tz": "head.tz +mca_work*mca_work_root_tz",
          "right_leg.tx": "right_leg.tx -mca_work*mca_work_root_tx",
          "right_leg.ty": "right_leg.ty -mca_work*mca_work_root_ty",
          "right_leg.tz": "right_leg.tz +mca_work*mca_work_root_tz",
          "left_leg.tx": "left_leg.tx -mca_work*mca_work_root_tx",
          "left_leg.ty": "left_leg.ty -mca_work*mca_work_root_ty",
          "left_leg.tz": "left_leg.tz +mca_work*mca_work_root_tz"
        },
        {
          "var.mca_upright": "if(is_riding || is_sneaking || mca_sleeping > 0.5, 0, 1)",
          "var.mca_mv": "clamp(limb_speed/0.33, 0, 1)*(1 -mca_work)*var.mca_upright*if(is_in_water && !is_on_ground, 0, 1)",
          "var.mca_step": "limb_swing*0.6662",
          "var.mca_lift": "mca_walk_bounce*abs(sin(var.mca_step))*var.mca_mv",
          "var.mca_stoop": "mca_elder*var.mca_upright*0.19 +mca_walk_lean*var.mca_mv",
          "body.rx": "body.rx +var.mca_stoop",
          "body.ry": "body.ry +mca_walk_sway*cos(var.mca_step)*var.mca_mv",
          "body.ty": "body.ty -12*(1 -cos(var.mca_stoop)) +var.mca_lift",
          "body.tz": "body.tz -12*sin(var.mca_stoop)",
          "head.rx": "head.rx +mca_walk_head*var.mca_mv",
          "head.ty": "head.ty -12*(1 -cos(var.mca_stoop)) +var.mca_lift",
          "head.tz": "head.tz -12*sin(var.mca_stoop)",
          "arms.rx": "arms.rx +var.mca_stoop",
          "arms.ty": "arms.ty -12*(1 -cos(var.mca_stoop)) +var.mca_lift",
          "arms.tz": "arms.tz -12*sin(var.mca_stoop)",
          "right_leg.rx": "right_leg.rx*(1 +(mca_walk_stride -1)*var.mca_mv)",
          "left_leg.rx": "left_leg.rx*(1 +(mca_walk_stride -1)*var.mca_mv)",
          "right_leg.ty": "right_leg.ty +var.mca_lift",
          "left_leg.ty": "left_leg.ty +var.mca_lift",
          "mca_right_arm.rx": "mca_right_arm.rx -var.mca_stoop -(mca_walk_arms -1)*sin(var.mca_ls)*limb_speed*var.mca_mv",
          "mca_left_arm.rx": "mca_left_arm.rx -var.mca_stoop +(mca_walk_arms -1)*sin(var.mca_ls)*limb_speed*var.mca_mv"
        }
      ]
    },
